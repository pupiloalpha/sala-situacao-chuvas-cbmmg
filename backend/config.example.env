# Copie este arquivo para .env e preencha os valores

# === E-mail (opcional) ===
# Deixe ENABLE_EMAIL=false se quiser apenas gerar o arquivo local
ENABLE_EMAIL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM=seu-email@gmail.com
EMAIL_TO=sala.situacao@cbmmg.mg.gov.br,outro@email.com

# === Configurações gerais ===
# Fuso horário usado no relatório
TIMEZONE=America/Sao_Paulo

# Pasta onde os relatórios são salvos (relativo a este diretório)
OUTPUT_DIR=relatorios
